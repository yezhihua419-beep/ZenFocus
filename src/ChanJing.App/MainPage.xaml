<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ChanJing_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ChanJing_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource BrushBackground}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
            <Grid Padding="48,20,48,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 头部 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="TitleText" x:Uid="MainPage_Title" Text="" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock x:Name="DateText" FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                    <!-- 设置齿轮：收纳深度模式/ADHD模式开关 -->
                    <Button x:Name="SettingsButton" Grid.Column="1" VerticalAlignment="Top"
                            Padding="10" Background="Transparent"
                            BorderBrush="{StaticResource BrushBorder}"
                            CornerRadius="20">
                        <FontIcon Glyph="&#xE713;" FontSize="16"
                                  Foreground="{StaticResource BrushTextSecondary}" />
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Spacing="8" Padding="4" MinWidth="260">
                                    <TextBlock x:Uid="MainPage_SettingsTitle" Text="" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextPrimary}" />
                                    <ToggleSwitch x:Name="DeepModeSwitch" Header="Deep Mode (untimed)" OffContent="Off" OnContent="On" Toggled="DeepMode_Toggled" />
                                    <ToggleSwitch x:Name="AdhdModeSwitch" Header="ADHD-Friendly (15-min)" OffContent="Off" OnContent="On" Toggled="AdhdMode_Toggled" />
                                    <TextBlock x:Uid="MainPage_ModeMutexHint" Text="" FontSize="11"
                                               Foreground="{StaticResource BrushTextSecondary}" Opacity="0.8" />
                                    <TextBlock x:Name="LangLabel" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"
                                               Foreground="{StaticResource BrushTextPrimary}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="LangEnButton" Click="LangEn_Click" Padding="12,6" CornerRadius="8" />
                                        <Button x:Name="LangZhButton" Click="LangZh_Click" Padding="12,6" CornerRadius="8" />
                                    </StackPanel>
                                    <TextBlock x:Name="HotkeyHint" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Foreground="{StaticResource BrushTextSecondary}" Opacity="0.85" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!-- 场景标签（顶部一行） -->
                <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" Spacing="4" Margin="0,12,0,4">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <Button x:Name="SceneWork" Tag="work" Click="Scene_Click" RightTapped="Scene_RightTapped"
                                Background="Transparent" BorderBrush="{StaticResource BrushTextSecondary}"
                                Foreground="{StaticResource BrushTextSecondary}"
                                Padding="16,5" CornerRadius="16" FontSize="12" />
                        <Button x:Name="SceneWrite" Tag="write" Click="Scene_Click" RightTapped="Scene_RightTapped"
                                Background="Transparent" BorderBrush="{StaticResource BrushTextSecondary}"
                                Foreground="{StaticResource BrushTextSecondary}"
                                Padding="16,5" CornerRadius="16" FontSize="12" />
                        <Button x:Name="SceneStudy" Tag="study" Click="Scene_Click" RightTapped="Scene_RightTapped"
                                Background="Transparent" BorderBrush="{StaticResource BrushTextSecondary}"
                                Foreground="{StaticResource BrushTextSecondary}"
                                Padding="16,5" CornerRadius="16" FontSize="12" />
                        <Button x:Name="SceneMeeting" Tag="meeting" Click="Scene_Click" RightTapped="Scene_RightTapped"
                                Background="Transparent" BorderBrush="{StaticResource BrushTextSecondary}"
                                Foreground="{StaticResource BrushTextSecondary}"
                                Padding="16,5" CornerRadius="16" FontSize="12" />
                    </StackPanel>
                    <TextBlock x:Name="SceneConfigHint" x:Uid="MainPage_SceneConfigHint" Text="" FontSize="11" HorizontalAlignment="Center"
                               Foreground="{StaticResource BrushTextSecondary}" Opacity="0.7" />
                </StackPanel>

                <!-- 首启3步引导浮层（首次启动显示，关闭后不再出现） -->
                <Border x:Name="GuidePanel" Grid.Row="1" Visibility="Collapsed" Margin="0,4,0,0"
                        Background="{StaticResource BrushCard}" CornerRadius="12"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                        Padding="20,14" MaxWidth="560" HorizontalAlignment="Center">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="MainPage_GuideTitle" Text="" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock x:Uid="MainPage_GuideStep1" Text="" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock x:Uid="MainPage_GuideStep2" Text="" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock x:Uid="MainPage_GuideStep3" Text="" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                        <Button x:Name="GuideCloseButton" Click="GuideClose_Click" HorizontalAlignment="Right"
                                Background="{StaticResource BrushState}" Foreground="White"
                                Padding="20,6" CornerRadius="16" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- 中间区域：空闲态/呼吸态/专注态/反馈态 -->
                <Grid Grid.Row="2" VerticalAlignment="Center">

                    <!-- 空闲态：呼吸感开始按钮 + 今日一愿 -->
                    <StackPanel x:Name="IdlePanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Spacing="16" MaxWidth="440" MinWidth="280">
                        <TextBlock x:Uid="MainPage_WishLabel" Text="" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBox x:Name="WishBox" x:Uid="MainPage_WishBox" PlaceholderText="" FontSize="14"
                                 HorizontalAlignment="Stretch" Padding="14,10" TextWrapping="Wrap"
                                 Background="{StaticResource BrushPanel}"
                                 BorderBrush="{StaticResource BrushTextSecondary}" />
                        <Button x:Name="StartButton" Click="StartButton_Click"
                                FontSize="18" Padding="48,16" HorizontalAlignment="Center"
                                CornerRadius="32" MinWidth="200" MinHeight="56"
                                Background="{StaticResource BrushState}" Foreground="White" />
                        <TextBlock x:Name="AdminHint" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushWarning}" MaxWidth="400" Visibility="Collapsed" />
                        <TextBlock x:Name="AdminPrivacy" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTextSecondary}" MaxWidth="400" />
                        <TextBlock x:Name="SessionHint" FontSize="11" HorizontalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   x:Uid="MainPage_SessionHint" Text="" />

                    </StackPanel>

                    <!-- 呼吸引导：开始前的 3 秒静心 -->
                    <StackPanel x:Name="BreathingPanel" Visibility="Collapsed"
                                VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
                        <Grid Width="130" Height="130" HorizontalAlignment="Center">
                            <Ellipse x:Name="BreathCircle" Fill="{StaticResource BrushState}" Opacity="0.9"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="BreathScale" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <TextBlock x:Name="BreathText" x:Uid="MainPage_BreathIn" Text="" FontSize="16" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushState}" />
                        <TextBlock x:Uid="MainPage_BreathHint" Text="" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                        <Button x:Name="SkipBreathButton" Click="SkipBreath_Click" HorizontalAlignment="Center"
                                Background="Transparent" Foreground="{StaticResource BrushTextSecondary}"
                                Padding="16,6" CornerRadius="16" />
                    </StackPanel>

                    <!-- 专注态：正计时（无倒计时）+ 结束 -->
                    <StackPanel x:Name="FocusPanel" Visibility="Collapsed"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Spacing="12" MaxWidth="440" MinWidth="280">
                        <TextBlock x:Uid="MainPage_Focusing" Text="" FontSize="14" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushState}" />
                        <!-- 非深度模式：进度条 + 小字号分钟数；深度模式：隐藏时间 -->
                        <ProgressBar x:Name="FocusProgress" Maximum="100" Value="0"
                                     Width="240" Height="6" HorizontalAlignment="Center"
                                     Foreground="{StaticResource BrushState}" Background="{StaticResource BrushBorder}"
                                     CornerRadius="3" />
                        <TextBlock x:Name="TimerText" FontSize="13" HorizontalAlignment="Center" Text=""
                                   Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock x:Name="WishShow" FontSize="13" HorizontalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,12,0,0">
                            <Button x:Name="CompleteButton" Click="Complete_Click"
                                    Background="{StaticResource BrushState}" Foreground="White"
                                    Padding="20,10" CornerRadius="24" FontSize="13" />
                            <Button x:Name="BreakButton" x:Uid="MainPage_Break" Click="Break_Click"
                                    Background="Transparent" BorderBrush="{StaticResource BrushTextSecondary}"
                                    Foreground="{StaticResource BrushTextSecondary}"
                                    Padding="20,10" CornerRadius="24" FontSize="13" />
                            <Button x:Name="PauseButton" x:Uid="MainPage_Pause" Click="PauseToggle_Click"
                                    Background="Transparent" BorderBrush="{StaticResource BrushTextSecondary}"
                                    Foreground="{StaticResource BrushTextSecondary}"
                                    Padding="20,10" CornerRadius="24" FontSize="13" />
                            <Button x:Name="Rest5Button" Click="EmergencyPass_Click"
                                    Background="Transparent" BorderBrush="{StaticResource BrushTextSecondary}"
                                    Foreground="{StaticResource BrushTextSecondary}"
                                    Padding="20,10" CornerRadius="24" FontSize="13" />
                        </StackPanel>
                        <Button x:Name="AllowCurrentButton" AllowFocusOnInteraction="True"
                                Background="Transparent" BorderBrush="{StaticResource BrushTextSecondary}"
                                Foreground="{StaticResource BrushTextSecondary}"
                                Padding="20,6" CornerRadius="18" FontSize="12" HorizontalAlignment="Center">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Name="Allow5Item" Tag="5" Click="AllowCurrentMenu_Click" />
                                    <MenuFlyoutItem x:Name="Allow15Item" Tag="15" Click="AllowCurrentMenu_Click" />
                                    <MenuFlyoutItem x:Name="Allow30Item" Tag="30" Click="AllowCurrentMenu_Click" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <!-- 专注后反馈（正反馈：连续次数+再来15分钟） -->
                    <StackPanel x:Name="FeedbackPanel" Visibility="Collapsed"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Spacing="16" MaxWidth="480" MinWidth="280">
                        <TextBlock x:Name="FeedbackStreak" FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushAccent}" />
                        <TextBlock x:Name="FeedbackText" FontSize="15" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                        <Button x:Name="FeedbackAgainButton" x:Uid="MainPage_FeedbackAgain" Click="StartAgain_Click"
                                Background="{StaticResource BrushState}" Foreground="White"
                                Padding="32,12" CornerRadius="24" HorizontalAlignment="Center"
                                FontSize="14" MinWidth="160" MinHeight="48" />
                        <Button x:Name="FeedbackRestButton" x:Uid="MainPage_FeedbackRest" Click="FeedbackRest_Click"
                                Background="Transparent" Foreground="{StaticResource BrushTextSecondary}"
                                Padding="20,6" CornerRadius="18" HorizontalAlignment="Center" FontSize="12" />
                    </StackPanel>

                    <!-- 缓冲期界面（ADHD模式：专注结束后屏蔽保持10分钟） -->
                    <StackPanel x:Name="CooldownPanel" Visibility="Collapsed"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Spacing="14" MaxWidth="440" MinWidth="280">
                        <TextBlock x:Uid="MainPage_CooldownTitle" Text="" FontSize="16" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushState}" />
                        <TextBlock x:Name="CooldownText" FontSize="13" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   />
                        <TextBlock x:Uid="MainPage_CooldownHint" Text="" FontSize="11" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Foreground="{StaticResource BrushTextSecondary}" Opacity="0.8" />
                        <Button x:Name="CooldownAgainButton" Click="CooldownAgain_Click"
                                Background="{StaticResource BrushState}" Foreground="White"
                                Padding="32,12" CornerRadius="24" HorizontalAlignment="Center"
                                FontSize="14" MinWidth="160" MinHeight="48" />
                        <Button x:Name="CooldownReleaseButton" x:Uid="MainPage_CooldownRelease" Click="CooldownRelease_Click"
                                Background="Transparent" Foreground="{StaticResource BrushTextSecondary}"
                                Padding="20,6" CornerRadius="18" HorizontalAlignment="Center" FontSize="12" />
                    </StackPanel>

                    <!-- 软着陆界面（缓冲期到期：用户选择后才解除屏蔽） -->
                    <StackPanel x:Name="SoftLandingPanel" Visibility="Collapsed"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Spacing="16" MaxWidth="440" MinWidth="280">
                        <TextBlock x:Uid="MainPage_SoftLandingTitle" Text="" FontSize="16" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushState}" />
                        <TextBlock x:Name="SoftLandingText" FontSize="13" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   />
                        <Button x:Name="SoftLandingAgainButton" Click="SoftLandingAgain_Click"
                                Background="{StaticResource BrushState}" Foreground="White"
                                Padding="32,12" CornerRadius="24" HorizontalAlignment="Center"
                                FontSize="14" MinWidth="160" MinHeight="48" />
                        <Button x:Name="SoftLandingReleaseButton" Click="SoftLandingRelease_Click"
                                Background="Transparent" Foreground="{StaticResource BrushTextSecondary}"
                                Padding="20,6" CornerRadius="18" HorizontalAlignment="Center" FontSize="12" />
                        <TextBlock x:Uid="MainPage_SoftLandingHint" Text="" FontSize="10" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTextSecondary}" Opacity="0.6" />
                    </StackPanel>
                </Grid>

                <!-- 今日一句话反馈 -->
                <TextBlock Grid.Row="3" x:Name="TodayFeedback" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource BrushTextSecondary}" Margin="0,12,0,0"
                           />

                <!-- 底部：今日统计 -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="40" Margin="0,16,0,0">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="TodayCount" FontSize="20" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock x:Uid="MainPage_TodayCountLabel" Text="" FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="TodayMinutes" FontSize="20" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock x:Uid="MainPage_TodayMinutesLabel" Text="" FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="BlockStatus" FontSize="20" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{StaticResource BrushState}" />
                        <TextBlock x:Uid="MainPage_BlockStatusLabel" Text="" FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                </StackPanel>

                <!-- 底部：手机伴侣二维码（付费功能） -->
                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,20,0,0"
                            Tapped="CompanionPaid_Tapped">
                    <Border x:Name="QrCodeBorder" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="10">
                        <Image x:Name="QrCodeImage" Width="80" Height="80" Stretch="Uniform" />
                    </Border>
                    <StackPanel Spacing="4" VerticalAlignment="Center" MaxWidth="240">
                        <TextBlock x:Name="CompanionTitleText" x:Uid="MainPage_CompanionTitle" Text="" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock x:Name="CompanionDescText" x:Uid="MainPage_CompanionDesc" Text="" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock x:Name="ConnectUrlText" FontSize="11" Foreground="{StaticResource BrushAccent}" />
                        <TextBlock x:Name="CompanionUpgradeText" x:Uid="MainPage_CompanionUpgrade" Text="" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource BrushWarning}" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
