<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ChanJing_App.ShieldPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ChanJing_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource BrushBackground}" Padding="48,24,48,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="屏蔽" FontSize="26" FontWeight="SemiBold"
                   Foreground="{StaticResource BrushTextPrimary}" />
        <TextBlock Grid.Row="0" FontSize="13" Margin="0,34,0,0"
                   Foreground="{StaticResource BrushTextSecondary}"
                   Text="选择要屏蔽的分类，勾选后点击「应用屏蔽」生效" />

        <!-- 分类名单 -->
        <StackPanel x:Name="CategoryPanel" Grid.Row="1" Margin="0,12,0,0" Spacing="8" />

        <!-- 自定义域名 -->
        <StackPanel Grid.Row="2" Margin="0,20,0,0" Spacing="8">
            <TextBlock Text="自定义域名" FontSize="13"
                       Foreground="{StaticResource BrushTextSecondary}" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBox x:Name="DomainBox" PlaceholderText="如 example.com，可多个逗号分隔"
                         Width="300" Padding="12,8"
                         Background="{StaticResource BrushPanel}"
                         BorderBrush="{StaticResource BrushTextSecondary}" />
                <Button Content="添加" Click="AddDomain_Click"
                        Background="{StaticResource BrushState}" Foreground="White" Padding="18,8" />
            </StackPanel>
            <ItemsControl x:Name="DomainList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="12" Margin="0,2"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- 操作区 -->
        <StackPanel Grid.Row="4" Spacing="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                <Button x:Name="ApplyButton" Content="应用屏蔽" Click="Apply_Click"
                        Background="{StaticResource BrushState}" Foreground="White"
                        Padding="32,10" CornerRadius="24" />
                <Button Content="撤销屏蔽" Click="Remove_Click"
                        Background="Transparent" BorderBrush="{StaticResource BrushTextSecondary}"
                        Foreground="{StaticResource BrushTextSecondary}"
                        Padding="32,10" CornerRadius="24" />
            </StackPanel>
            <TextBlock x:Name="StatusText" FontSize="12" HorizontalAlignment="Center"
                       Foreground="{StaticResource BrushState}" />
            <TextBlock FontSize="11" HorizontalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource BrushTextSecondary}"
                       Text="说明：屏蔽通过 hosts 生效，覆盖所有浏览器（含隐身窗口）。仅管理禅净自己的配置段，不触碰其他软件条目。" />
        </StackPanel>
    </Grid>
</Page>
