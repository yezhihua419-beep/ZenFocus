<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ChanJing_App.ShieldPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ChanJing_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource BrushBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
            <Grid Padding="48,24,48,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <StackPanel Grid.Row="0" Spacing="4">
                    <TextBlock x:Uid="ShieldPage_Title" Text="" FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}" />
                    <TextBlock x:Name="SceneStateHint" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushState}"
                               Visibility="Collapsed" />
                    <TextBlock FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextSecondary}"
                               x:Uid="ShieldPage_Subtitle" Text="" />
                    <ToggleSwitch x:Name="ManualShieldSwitch" x:Uid="ShieldPage_ManualShield" Header="" OffContent="" OnContent=""
                                  Toggled="ManualShield_Toggled" Margin="0,12,0,0" />
                    <TextBlock x:Name="ManualShieldHint" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextSecondary}"
                               x:Uid="ShieldPage_ManualShieldHint" Text="" Visibility="Collapsed" />
                </StackPanel>

                <!-- 分类名单 -->
                <StackPanel Grid.Row="1" Margin="0,20,0,0" Spacing="8">
                    <TextBlock x:Uid="ShieldPage_CategoryTitle" Text="" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}" />
                    <ItemsControl x:Name="CategoryPanel">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="140" ItemHeight="40" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock x:Name="LimitHint" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushWarning}"
                               x:Uid="ShieldPage_LimitHint" Text="" />
                </StackPanel>

                <!-- 桌面应用拦截（高频，前置展开） -->
                <StackPanel Grid.Row="2" Margin="0,20,0,0" Spacing="8">
                    <TextBlock x:Uid="ShieldPage_AppBlockTitle" Text="" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Uid="ShieldPage_AppModeLabel" Text="" VerticalAlignment="Center" />
                        <ComboBox x:Name="AppModeBox" Width="160" SelectionChanged="AppMode_Changed">
                            <ComboBoxItem x:Uid="ShieldPage_AppModeMinimize" Content="" Tag="minimize" />
                            <ComboBoxItem x:Uid="ShieldPage_AppModeKill" Content="" Tag="kill" />
                        </ComboBox>
                    </StackPanel>
                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextSecondary}"
                               x:Uid="ShieldPage_AppModeHint" Text="" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <TextBlock x:Uid="ShieldPage_FocusOnlyCommLabel" Text="" VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                        <ToggleSwitch x:Name="FocusOnlyCommSwitch"
                                      IsOn="False" Toggled="FocusOnlyComm_Toggled" />
                    </StackPanel>
                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextSecondary}"
                               x:Uid="ShieldPage_FocusOnlyCommHint" Text="" />
                    <!-- ADHD模式缓冲期时长 -->
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                        <TextBlock x:Uid="ShieldPage_CooldownLabel" Text="" VerticalAlignment="Center" FontSize="13" />
                        <ComboBox x:Name="CooldownMinutesBox" Width="120" SelectionChanged="CooldownMinutes_Changed">
                            <ComboBoxItem Content="5" Tag="5" />
                            <ComboBoxItem Content="10" Tag="10" IsSelected="True" />
                            <ComboBoxItem Content="15" Tag="15" />
                            <ComboBoxItem x:Uid="ShieldPage_Cooldown20" Content="" Tag="20" />
                            <ComboBoxItem x:Uid="ShieldPage_Cooldown30" Content="" Tag="30" />
                        </ComboBox>
                    </StackPanel>
                    <TextBlock x:Name="CooldownHint" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextSecondary}"
                               x:Uid="ShieldPage_CooldownHint" Text="" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <TextBox x:Name="AppBox" x:Uid="ShieldPage_AppBox" PlaceholderText="" Width="200" />
                        <ComboBox x:Name="AppCategoryBox" Width="120">
                            <ComboBoxItem x:Uid="ShieldPage_AppCatShort" Content="" IsSelected="True" />
                            <ComboBoxItem x:Uid="ShieldPage_AppCatVideo" Content="" />
                            <ComboBoxItem x:Uid="ShieldPage_AppCatSocial" Content="" />
                            <ComboBoxItem x:Uid="ShieldPage_AppCatNews" Content="" />
                            <ComboBoxItem x:Uid="ShieldPage_AppCatShop" Content="" />
                            <ComboBoxItem x:Uid="ShieldPage_AppCatComm" Content="" />
                        </ComboBox>
                        <Button x:Uid="ShieldPage_AddApp" Content="" Click="AddApp_Click" Padding="16,8" />
                    </StackPanel>
                    <ItemsControl x:Name="AppList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                        <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Process}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Grid.Column="2" x:Uid="ShieldPage_RemoveApp" Content="" Tag="{Binding Process}"
                                            Visibility="{Binding RemoveVis}"
                                            Click="RemoveApp_Click" FontSize="11" Padding="10,2" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextSecondary}"
                               x:Uid="ShieldPage_AppListHint" Text="" />
                </StackPanel>

                <!-- 自定义域名（低频，折叠） -->
                <Expander Grid.Row="3" x:Uid="ShieldPage_CustomDomain" Header="" Margin="0,16,0,0">
                    <StackPanel Spacing="8" Padding="0,10,0,0">
                        <TextBlock FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   x:Uid="ShieldPage_CustomDomainHint" Text="" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="DomainBox" x:Uid="ShieldPage_DomainBox" PlaceholderText="" Width="280" />
                            <Button x:Uid="ShieldPage_AddDomain" Content="" Click="AddDomain_Click" Padding="16,8" />
                        </StackPanel>
                        <ItemsControl x:Name="DomainList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <!-- 每日限额（低频，折叠） -->
                <Expander Grid.Row="4" x:Uid="ShieldPage_DailyLimit" Header="" Margin="0,16,0,0">
                    <StackPanel Spacing="8" Padding="0,10,0,0">
                        <TextBlock FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   x:Uid="ShieldPage_DailyLimitHint" Text="" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="LimitDomainBox" x:Uid="ShieldPage_LimitDomainBox" PlaceholderText="" Width="200" />
                            <NumberBox x:Name="LimitMinutesBox" x:Uid="ShieldPage_LimitMinutes" Header="" Minimum="5" Maximum="1440"
                                       Value="30" SmallChange="5" LargeChange="30" Width="110" SpinButtonPlacementMode="Compact" />
                            <Button x:Uid="ShieldPage_AddLimit" Content="" Click="AddLimit_Click" Padding="16,8" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <ItemsControl x:Name="LimitList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Domain}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                            <TextBlock Text="{Binding Minutes}" />
                                            <TextBlock x:Uid="ShieldPage_LimitUnit" Text="" Foreground="{StaticResource BrushTextSecondary}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" x:Uid="ShieldPage_DeleteLimit" Content="" Tag="{Binding Domain}"
                                                Click="DeleteLimit_Click" FontSize="11" Padding="10,2" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <!-- 临时放行（低频，折叠） -->
                <Expander Grid.Row="5" x:Uid="ShieldPage_TempAllow" Header="" Margin="0,16,0,0">
                    <StackPanel Spacing="8" Padding="0,10,0,0">
                        <TextBlock FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   x:Uid="ShieldPage_TempAllowHint" Text="" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="AllowDomainBox" PlaceholderText="域名如 bilibili.com" Width="200" />
                            <Button x:Uid="ShieldPage_AllowButton" Content="" Padding="16,8">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="放行 5 分钟" Tag="5" Click="AddAllowMenu_Click" />
                                        <MenuFlyoutItem Text="放行 15 分钟" Tag="15" Click="AddAllowMenu_Click" />
                                        <MenuFlyoutItem Text="放行 30 分钟" Tag="30" Click="AddAllowMenu_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Uid="ShieldPage_ClearAllow" Content="" Click="ClearAllow_Click" Padding="16,8" />
                        </StackPanel>
                        <ItemsControl x:Name="AllowList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,2"
                                               Foreground="{StaticResource BrushTextSecondary}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="AllowStatus" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                </Expander>
            </Grid>
        </ScrollViewer>

        <!-- 固定底部操作栏 -->
        <Border Grid.Row="1" Background="{StaticResource BrushCard}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0">
            <StackPanel Padding="48,12" Spacing="6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                    <Button x:Name="ApplyButton" x:Uid="ShieldPage_Apply" Content="" Click="Apply_Click"
                            Background="{StaticResource BrushState}" Foreground="White"
                            Padding="28,10" CornerRadius="24" />
                    <Button x:Uid="ShieldPage_Clear" Content="" Click="Remove_Click"
                            Background="Transparent" BorderBrush="{StaticResource BrushTextSecondary}"
                            Foreground="{StaticResource BrushTextSecondary}"
                            Padding="28,10" CornerRadius="24" />
                    <Button x:Uid="ShieldPage_Export" Content="" Click="ExportConfig_Click"
                            Background="Transparent" BorderBrush="{StaticResource BrushTextSecondary}"
                            Foreground="{StaticResource BrushTextSecondary}"
                            Padding="20,10" CornerRadius="24" FontSize="12" />
                    <Button x:Uid="ShieldPage_Import" Content="" Click="ImportConfig_Click"
                            Background="Transparent" BorderBrush="{StaticResource BrushTextSecondary}"
                            Foreground="{StaticResource BrushTextSecondary}"
                            Padding="20,10" CornerRadius="24" FontSize="12" />
                    <Button x:Uid="ShieldPage_Feedback" Content="" Click="Feedback_Click"
                            Background="Transparent" BorderBrush="{StaticResource BrushTextSecondary}"
                            Foreground="{StaticResource BrushTextSecondary}"
                            Padding="20,10" CornerRadius="24" FontSize="12" />
                </StackPanel>
                <TextBlock x:Name="StatusText" FontSize="12" HorizontalAlignment="Center"
                           Foreground="{StaticResource BrushState}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
