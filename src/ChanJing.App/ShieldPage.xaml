<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ChanJing_App.ShieldPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ChanJing_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource BrushBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
            <Grid Padding="48,24,48,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <StackPanel Grid.Row="0" Spacing="4">
                    <TextBlock x:Uid="ShieldPage_Title" Text="" FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}" />
                    <TextBlock x:Name="SceneStateHint" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushState}"
                               Visibility="Collapsed" />
                    <TextBlock FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextSecondary}"
                               x:Uid="ShieldPage_Subtitle" Text="" />
                    <TextBlock x:Name="AdminHint" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushWarning}" Visibility="Collapsed" />
                    <TextBlock x:Name="AdminPrivacy" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextSecondary}" />
                    <Button x:Name="ElevateButton" Click="Elevate_Click" Margin="0,8,0,0"
                            Padding="16,8" CornerRadius="16" Visibility="Collapsed" />
                    <ToggleSwitch x:Name="ManualShieldSwitch"
                                  Toggled="ManualShield_Toggled" Margin="0,12,0,0" />
                    <TextBlock x:Name="ManualShieldHint" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextSecondary}"
                               x:Uid="ShieldPage_ManualShieldHint" Text="" Visibility="Collapsed" />
                </StackPanel>

                <!-- 分类名单 -->
                <StackPanel Grid.Row="1" Margin="0,20,0,0" Spacing="8">
                    <TextBlock x:Uid="ShieldPage_CategoryTitle" Text="" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="CatalogLabel" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                        <ComboBox x:Name="CatalogBox" Width="280" SelectionChanged="Catalog_Changed">
                            <ComboBoxItem x:Name="CatalogIntl" Tag="en-US" />
                            <ComboBoxItem x:Name="CatalogChina" Tag="zh-CN" />
                        </ComboBox>
                    </StackPanel>
                    <TextBlock x:Name="CatalogHint" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextSecondary}" />
                    <ItemsControl x:Name="CategoryPanel">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="140" ItemHeight="40" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock x:Name="LimitHint" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushWarning}"
                               x:Uid="ShieldPage_LimitHint" Text="" />
                </StackPanel>

                <!-- 桌面应用拦截（高频，前置展开） -->
                <StackPanel Grid.Row="2" Margin="0,20,0,0" Spacing="8">
                    <TextBlock x:Uid="ShieldPage_AppBlockTitle" Text="" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Uid="ShieldPage_AppModeLabel" Text="" VerticalAlignment="Center" />
                        <ComboBox x:Name="AppModeBox" Width="160" SelectionChanged="AppMode_Changed">
                            <ComboBoxItem x:Name="ModeMinimize" Tag="minimize" Content="Minimize" />
                            <ComboBoxItem x:Name="ModeKill" Tag="kill" Content="Kill process" />
                        </ComboBox>
                    </StackPanel>
                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextSecondary}"
                               x:Uid="ShieldPage_AppModeHint" Text="" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <TextBlock x:Uid="ShieldPage_FocusOnlyCommLabel" Text="" VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                        <ToggleSwitch x:Name="FocusOnlyCommSwitch"
                                      IsOn="False" Toggled="FocusOnlyComm_Toggled" />
                    </StackPanel>
                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextSecondary}"
                               x:Uid="ShieldPage_FocusOnlyCommHint" Text="" />
                    <!-- ADHD模式缓冲期时长 -->
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                        <TextBlock x:Uid="ShieldPage_CooldownLabel" Text="" VerticalAlignment="Center" FontSize="13" />
                        <ComboBox x:Name="CooldownMinutesBox" Width="120" SelectionChanged="CooldownMinutes_Changed">
                            <ComboBoxItem Content="5" Tag="5" />
                            <ComboBoxItem Content="10" Tag="10" IsSelected="True" />
                            <ComboBoxItem Content="15" Tag="15" />
                            <ComboBoxItem x:Name="Cooldown20" Tag="20" Content="20" />
                            <ComboBoxItem x:Name="Cooldown30" Tag="30" Content="30" />
                        </ComboBox>
                    </StackPanel>
                    <TextBlock x:Name="CooldownHint" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextSecondary}"
                               x:Uid="ShieldPage_CooldownHint" Text="" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <TextBox x:Name="AppBox" PlaceholderText="Process name" Width="200" />
                        <ComboBox x:Name="AppCategoryBox" Width="120">
                            <ComboBoxItem x:Name="CatShort" Tag="短视频" Content="短视频" IsSelected="True" />
                            <ComboBoxItem x:Name="CatVideo" Tag="视频娱乐" Content="视频娱乐" />
                            <ComboBoxItem x:Name="CatSocial" Tag="社交" Content="社交" />
                            <ComboBoxItem x:Name="CatNews" Tag="资讯" Content="资讯" />
                            <ComboBoxItem x:Name="CatShop" Tag="购物" Content="购物" />
                            <ComboBoxItem x:Name="CatComm" Tag="沟通工具" Content="沟通工具" />
                        </ComboBox>
                        <Button x:Name="AddAppButton" Content="Add" Click="AddApp_Click" Padding="16,8" />
                    </StackPanel>
                    <ItemsControl x:Name="AppList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                        <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Process}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{Binding RemoveLabel}" Tag="{Binding Process}"
                                            Visibility="{Binding RemoveVis}"
                                            Click="RemoveApp_Click" FontSize="11" Padding="10,2" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextSecondary}"
                               x:Uid="ShieldPage_AppListHint" Text="" />
                </StackPanel>

                <!-- 自定义域名（低频，折叠） -->
                <Expander x:Name="CustomDomainExpander" Grid.Row="3" Header="Custom domains" Margin="0,16,0,0">
                    <StackPanel Spacing="8" Padding="0,10,0,0">
                        <TextBlock FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   x:Uid="ShieldPage_CustomDomainHint" Text="" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="DomainBox" PlaceholderText="example.com" Width="280" />
                            <Button x:Name="AddDomainButton" Content="Add" Click="AddDomain_Click" Padding="16,8" />
                        </StackPanel>
                        <ItemsControl x:Name="DomainList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Domain}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="{Binding RemoveLabel}" Tag="{Binding Domain}"
                                                Click="RemoveDomain_Click" FontSize="11" Padding="10,2" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <!-- 每日限额（低频，折叠） -->
                <Expander x:Name="DailyLimitExpander" Grid.Row="4" Header="Daily limits" Margin="0,16,0,0">
                    <StackPanel Spacing="8" Padding="0,10,0,0">
                        <TextBlock FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   x:Uid="ShieldPage_DailyLimitHint" Text="" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="LimitDomainBox" PlaceholderText="bilibili.com" Width="200" />
                            <NumberBox x:Name="LimitMinutesBox" Header="Minutes/day" Minimum="5" Maximum="1440"
                                       Value="30" SmallChange="5" LargeChange="30" Width="110" SpinButtonPlacementMode="Compact" />
                            <Button x:Name="AddLimitButton" Content="Add" Click="AddLimit_Click" Padding="16,8" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <ItemsControl x:Name="LimitList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Domain}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                            <TextBlock Text="{Binding Minutes}" />
                                            <TextBlock x:Uid="ShieldPage_LimitUnit" Text="" Foreground="{StaticResource BrushTextSecondary}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="{Binding DeleteLabel}" Tag="{Binding Domain}"
                                                Click="DeleteLimit_Click" FontSize="11" Padding="10,2" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <!-- 临时放行（低频，折叠） -->
                <Expander x:Name="TempAllowExpander" Grid.Row="5" Header="Temporary allow" Margin="0,16,0,0">
                    <StackPanel Spacing="8" Padding="0,10,0,0">
                        <TextBlock FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   x:Uid="ShieldPage_TempAllowHint" Text="" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="AllowDomainBox" PlaceholderText="example.com" Width="200" />
                            <Button x:Name="AllowButton" Content="Allow…" Padding="16,8">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Name="Allow5Item" Tag="5" Click="AddAllowMenu_Click" />
                                        <MenuFlyoutItem x:Name="Allow15Item" Tag="15" Click="AddAllowMenu_Click" />
                                        <MenuFlyoutItem x:Name="Allow30Item" Tag="30" Click="AddAllowMenu_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="ClearAllowButton" Content="Clear allows" Click="ClearAllow_Click" Padding="16,8" />
                        </StackPanel>
                        <ItemsControl x:Name="AllowList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,2"
                                               Foreground="{StaticResource BrushTextSecondary}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="AllowStatus" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                </Expander>
            </Grid>
        </ScrollViewer>

        <!-- 固定底部操作栏 -->
        <Border Grid.Row="1" Background="{StaticResource BrushCard}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0">
            <StackPanel Padding="48,12" Spacing="6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                    <Button x:Name="ApplyButton" Content="Save config" Click="Apply_Click"
                            Background="{StaticResource BrushState}" Foreground="White"
                            Padding="28,10" CornerRadius="24" />
                    <Button x:Name="ClearButton" Content="Clear" Click="Remove_Click"
                            Background="Transparent" BorderBrush="{StaticResource BrushTextSecondary}"
                            Foreground="{StaticResource BrushTextSecondary}"
                            Padding="28,10" CornerRadius="24" />
                    <Button x:Name="ExportButton" Content="Export" Click="ExportConfig_Click"
                            Background="Transparent" BorderBrush="{StaticResource BrushTextSecondary}"
                            Foreground="{StaticResource BrushTextSecondary}"
                            Padding="20,10" CornerRadius="24" FontSize="12" />
                    <Button x:Name="ImportButton" Content="Import" Click="ImportConfig_Click"
                            Background="Transparent" BorderBrush="{StaticResource BrushTextSecondary}"
                            Foreground="{StaticResource BrushTextSecondary}"
                            Padding="20,10" CornerRadius="24" FontSize="12" />
                    <Button x:Name="DiagnoseButton" Content="Diagnose" Click="Diagnose_Click"
                            Background="Transparent" BorderBrush="{StaticResource BrushTextSecondary}"
                            Foreground="{StaticResource BrushTextSecondary}"
                            Padding="20,10" CornerRadius="24" FontSize="12" />
                    <Button x:Name="FeedbackButton" Content="Feedback" Click="Feedback_Click"
                            Background="Transparent" BorderBrush="{StaticResource BrushTextSecondary}"
                            Foreground="{StaticResource BrushTextSecondary}"
                            Padding="20,10" CornerRadius="24" FontSize="12" />
                </StackPanel>
                <TextBlock x:Name="StatusText" FontSize="12" HorizontalAlignment="Center"
                           Foreground="{StaticResource BrushState}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
