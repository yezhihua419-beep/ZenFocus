<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ChanJing_App.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ChanJing_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource BrushBackground}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
            <StackPanel Padding="48,24,48,28" Spacing="16">

                <!-- 标题 -->
                <StackPanel Spacing="4">
                    <TextBlock Text="统计" FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}" />
                </StackPanel>

                <!-- 洞察文字区：分心模式识别 + 今日反馈，垂直排列不重叠 -->
                <StackPanel Spacing="4" Margin="0,0,0,0">
                    <TextBlock x:Name="PatternInsight" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushAccent}" Visibility="Collapsed" />
                    <TextBlock x:Name="InsightText" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushState}" Text="今日已专注 0 分钟 · 每一次定心都是进步" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="32" Margin="0,0,0,0"
                            HorizontalAlignment="Left">
                    <StackPanel Spacing="2" MinWidth="80">
                        <TextBlock x:Name="TodayCount" FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="今日定心（次）" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                    <StackPanel Spacing="2" MinWidth="80">
                        <TextBlock x:Name="TodayMinutes" FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="今日专注（分）" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                    <StackPanel Spacing="2" MinWidth="80">
                        <TextBlock x:Name="StreakDays" FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{StaticResource BrushState}" />
                        <TextBlock Text="连续定心（天）" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                    <StackPanel Spacing="2" MinWidth="80">
                        <TextBlock x:Name="DistractionCount" FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock Text="起身活动（次）" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                    <StackPanel Spacing="2" MinWidth="80">
                        <TextBlock x:Name="QualityScore" FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{StaticResource BrushState}" />
                        <TextBlock Text="专注质量（分）" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                    <Button Content="生成今日卡片" Click="ShareCard_Click"
                            VerticalAlignment="Center"
                            Background="{StaticResource BrushPanel}"
                            Foreground="{StaticResource BrushTextPrimary}"
                            BorderBrush="{StaticResource BrushTextSecondary}" Padding="16,8" />
                </StackPanel>

                <!-- 付费功能预览钩子 -->
                <Border Background="{StaticResource BrushPanel}" CornerRadius="8" Padding="16,12" Margin="0,0,0,0" Visibility="Collapsed" x:Name="PremiumPreview">
                    <StackPanel Spacing="4">
                        <TextBlock Text="升级解锁更多洞察" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" />
                        <TextBlock Text="付费版：最专注时段分析 · 分心模式识别 · 跨设备同步屏蔽 · 无限自定义场景" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                </Border>

                <!-- 高效时段分析（付费） -->
                <StackPanel x:Name="PeakHourSection" Margin="0,0,0,0" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="最高效时段（近30天）" FontSize="13"
                               Foreground="{StaticResource BrushTextSecondary}" />
                    <TextBlock x:Name="PeakHourText" FontSize="14" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushState}" />
                </StackPanel>

                <!-- 连续纪录历史（付费） -->
                <StackPanel x:Name="StreakHistorySection" Margin="0,0,0,0" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="连续纪录" FontSize="13"
                               Foreground="{StaticResource BrushTextSecondary}" />
                    <TextBlock x:Name="StreakHistoryText" FontSize="14" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushAccent}" />
                </StackPanel>

                <!-- 空状态引导：无记录时提示，并隐藏图表区 -->
                <TextBlock x:Name="EmptyHint" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,0"
                           Foreground="{StaticResource BrushTextSecondary}" Visibility="Collapsed"
                           Text="还没有专注记录。回到「禅定」页点击开始专注，完成后这里会显示近 7 天、24 小时分布、本月热力和今日使用分布。" />

                <!-- 近 7 天柱状 -->
                <StackPanel x:Name="WeekSection" Margin="0,0,0,0" Spacing="0">
                    <TextBlock Text="近 7 天专注（分钟）" FontSize="13"
                               Foreground="{StaticResource BrushTextSecondary}" />
                    <Grid x:Name="WeekChart" Height="110" Margin="0,0,0,0" />
                    <Grid x:Name="WeekLabels" Height="18" />
                </StackPanel>

                <!-- 今日 24 小时时间轴 -->
                <StackPanel x:Name="HourSection" Margin="0,0,0,0" Spacing="0">
                    <TextBlock Text="今日 24 小时专注分布" FontSize="13"
                               Foreground="{StaticResource BrushTextSecondary}" />
                    <Grid x:Name="HourlyChart" Height="90" Margin="0,0,0,0" />
                    <Grid x:Name="HourlyLabels" Height="16" />
                </StackPanel>

                <!-- 本月热力 -->
                <StackPanel x:Name="MonthSection" Margin="0,0,0,0" Spacing="0">
                    <TextBlock Text="本月专注热力" FontSize="13"
                               Foreground="{StaticResource BrushTextSecondary}" />
                    <Grid x:Name="MonthChart" Margin="0,0,0,0" HorizontalAlignment="Left" />
                </StackPanel>

                <!-- 今日使用分布 -->
                <StackPanel x:Name="UsageSection" Margin="0,0,0,0" Spacing="0">
                    <TextBlock Text="今日使用分布" FontSize="13"
                               Foreground="{StaticResource BrushTextSecondary}" />
                    <ItemsControl x:Name="UsageList" Margin="0,0,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="130,*,70" Margin="0,5">
                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding NameBrush}" />
                                    <ProgressBar Grid.Column="1" Maximum="{Binding Max}" Value="{Binding Value}"
                                                 Height="8" VerticalAlignment="Center"
                                                 Foreground="{StaticResource BrushState}"
                                                 Background="{StaticResource BrushPanel}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="12"
                                               HorizontalAlignment="Right"
                                               Foreground="{StaticResource BrushTextSecondary}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 分享卡片（离屏渲染用，平时隐藏，不占布局位） -->
        <Grid x:Name="ShareCard" Visibility="Collapsed" Width="560" Padding="36,28"
              Background="{StaticResource BrushBackground}" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel Spacing="8">
                <TextBlock Text="禅净 · 今日定心" FontSize="14"
                           Foreground="{StaticResource BrushState}" />
                <StackPanel Orientation="Horizontal" Spacing="44" Margin="0,0,0,0">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="ShareCount" FontSize="40" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="次定心" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="ShareMinutes" FontSize="40" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="分钟专注" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="ShareStreak" FontSize="40" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{StaticResource BrushState}" />
                        <TextBlock Text="连续定心天数" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="ShareQuality" FontSize="40" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{StaticResource BrushAccent}" />
                        <TextBlock Text="专注质量分" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="ShareQuote" FontSize="13" Margin="0,0,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource BrushTextSecondary}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
