<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ChanJing_App.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ChanJing_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource BrushBackground}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
            <StackPanel Padding="48,24,48,28" Spacing="16">

                <!-- 标题 -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="StatsPage_Title" Text="" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Uid="StatsPage_Export" Content="" Click="ExportData_Click"
                            VerticalAlignment="Center"
                            Background="{StaticResource BrushPanel}"
                            Foreground="{StaticResource BrushTextPrimary}"
                            BorderBrush="{StaticResource BrushTextSecondary}" Padding="14,6"
                            FontSize="12" />
                </Grid>

                <!-- 洞察文字区：分心模式识别 + 今日反馈，垂直排列不重叠 -->
                <StackPanel Spacing="4" Margin="0,0,0,0">
                    <TextBlock x:Name="PatternInsight" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushAccent}" Visibility="Collapsed" />
                    <TextBlock x:Name="InsightText" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushState}" x:Uid="StatsPage_InsightDefault" Text="" />
                </StackPanel>
                <!-- 核心数字区：自动换行，窗口缩小时不叠加 -->
                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="108" ItemHeight="66"
                            HorizontalAlignment="Left" Margin="0,-4,0,0">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="TodayCount" FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock x:Uid="StatsPage_TodayCountLabel" Text="" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="TodayMinutes" FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock x:Uid="StatsPage_TodayMinutesLabel" Text="" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="StreakDays" FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{StaticResource BrushState}" />
                        <TextBlock x:Uid="StatsPage_StreakLabel" Text="" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="DistractionCount" FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock x:Uid="StatsPage_DistractionLabel" Text="" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="QualityScore" FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{StaticResource BrushState}" />
                        <TextBlock x:Uid="StatsPage_QualityLabel" Text="" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                    <Button x:Uid="StatsPage_ShareCard" Content="" Click="ShareCard_Click"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Background="{StaticResource BrushPanel}"
                            Foreground="{StaticResource BrushTextPrimary}"
                            BorderBrush="{StaticResource BrushTextSecondary}" Padding="16,8" />
                </ItemsWrapGrid>

                <!-- 付费功能预览钩子 -->
                <Border Background="{StaticResource BrushPanel}" CornerRadius="8" Padding="16,12" Margin="0,0,0,0" Visibility="Collapsed" x:Name="PremiumPreview">
                    <StackPanel Spacing="8">
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="StatsPage_UpgradeTitle" Text="" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" />
                            <TextBlock x:Uid="StatsPage_UpgradeDesc" Text="" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" />
                        </StackPanel>
                        <Button x:Uid="StatsPage_UpgradeButton" Content="" Click="Upgrade_Click"
                                Background="{StaticResource BrushState}" Foreground="White"
                                Padding="20,8" CornerRadius="16" HorizontalAlignment="Left" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- 高效时段分析（付费） -->
                <StackPanel x:Name="PeakHourSection" Margin="0,0,0,0" Spacing="4" Visibility="Collapsed">
                    <TextBlock x:Uid="StatsPage_PeakHourTitle" Text="" FontSize="13"
                               Foreground="{StaticResource BrushTextSecondary}" />
                    <TextBlock x:Name="PeakHourText" FontSize="14" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushState}" />
                </StackPanel>

                <!-- 连续纪录历史（付费） -->
                <StackPanel x:Name="StreakHistorySection" Margin="0,0,0,0" Spacing="4" Visibility="Collapsed">
                    <TextBlock x:Uid="StatsPage_StreakHistoryTitle" Text="" FontSize="13"
                               Foreground="{StaticResource BrushTextSecondary}" />
                    <TextBlock x:Name="StreakHistoryText" FontSize="14" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushAccent}" />
                </StackPanel>

                <!-- 空状态引导：无记录时提示，并隐藏图表区 -->
                <TextBlock x:Name="EmptyHint" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,0"
                           Foreground="{StaticResource BrushTextSecondary}" Visibility="Collapsed"
                           x:Uid="StatsPage_EmptyHint" Text="" />

                <!-- 详细图表区：默认折叠，保持首页简洁 -->
                <Expander x:Name="ChartExpander" Margin="0,0,0,0" HorizontalAlignment="Stretch"
                          Background="{StaticResource BrushPanel}"
                          BorderBrush="{StaticResource BrushBorder}"
                          Foreground="{StaticResource BrushTextPrimary}">
                    <Expander.Header>
                        <TextBlock x:Uid="StatsPage_ChartExpander" Text="" FontSize="13" Foreground="{StaticResource BrushTextPrimary}" />
                    </Expander.Header>
                    <StackPanel Spacing="16" Padding="0,12,0,4">
                        <!-- 近 7 天柱状 -->
                        <StackPanel x:Name="WeekSection" Spacing="0">
                            <TextBlock x:Uid="StatsPage_WeekTitle" Text="" FontSize="13"
                                       Foreground="{StaticResource BrushTextSecondary}" />
                            <Grid x:Name="WeekChart" Height="110" Margin="0,4,0,0" />
                            <Grid x:Name="WeekLabels" Height="18" />
                        </StackPanel>

                        <!-- 今日 24 小时时间轴 -->
                        <StackPanel x:Name="HourSection" Spacing="0">
                            <TextBlock x:Uid="StatsPage_HourTitle" Text="" FontSize="13"
                                       Foreground="{StaticResource BrushTextSecondary}" />
                            <Grid x:Name="HourlyChart" Height="90" Margin="0,4,0,0" />
                            <Grid x:Name="HourlyLabels" Height="16" />
                        </StackPanel>

                        <!-- 本月热力 -->
                        <StackPanel x:Name="MonthSection" Spacing="0">
                            <TextBlock x:Uid="StatsPage_MonthTitle" Text="" FontSize="13"
                                       Foreground="{StaticResource BrushTextSecondary}" />
                            <Grid x:Name="MonthChart" Margin="0,4,0,0" HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- 分心来源TOP3 -->
                        <StackPanel x:Name="DistractionSourcesSection" Spacing="0">
                            <TextBlock x:Uid="StatsPage_DistractionSourcesTitle" Text="" FontSize="13"
                                       Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock x:Name="DistractionSourcesText" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{StaticResource BrushWarning}" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- 今日使用分布 -->
                        <StackPanel x:Name="UsageSection" Spacing="0">
                            <TextBlock x:Uid="StatsPage_UsageTitle" Text="" FontSize="13"
                                       Foreground="{StaticResource BrushTextSecondary}" />
                            <ItemsControl x:Name="UsageList" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="130,*,70" Margin="0,5">
                                            <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                       Foreground="{Binding NameBrush}" />
                                            <ProgressBar Grid.Column="1" Maximum="{Binding Max}" Value="{Binding Value}"
                                                         Height="8" VerticalAlignment="Center"
                                                         Foreground="{StaticResource BrushState}"
                                                         Background="{StaticResource BrushPanel}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="12"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{StaticResource BrushTextSecondary}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- 分享卡片（离屏渲染用，平时隐藏，不占布局位）：墨色底 + 金色"定"字禅意风格 -->
        <Grid x:Name="ShareCard" Visibility="Collapsed" Width="560" Padding="40,32"
              Background="#2B2925" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- 左侧大"定"字 -->
            <TextBlock x:Uid="StatsPage_ShareZenChar" Text="" FontSize="96" FontWeight="Light"
                       Foreground="#C9A84C" Margin="0,0,28,0"
                       VerticalAlignment="Center" />
            <!-- 右侧数据 -->
            <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock x:Uid="StatsPage_ShareTitle" Text="" FontSize="14"
                           Foreground="#C9A84C" />
                <StackPanel Orientation="Horizontal" Spacing="36" Margin="0,4,0,0">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="ShareCount" FontSize="36" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="#F4F1E8" />
                        <TextBlock x:Uid="StatsPage_ShareCountUnit" Text="" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="#A8A092" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="ShareMinutes" FontSize="36" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="#F4F1E8" />
                        <TextBlock x:Uid="StatsPage_ShareMinutesUnit" Text="" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="#A8A092" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="ShareStreak" FontSize="36" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="#C9A84C" />
                        <TextBlock x:Uid="StatsPage_ShareStreakUnit" Text="" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="#A8A092" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="ShareQuality" FontSize="36" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="#9AB08A" />
                        <TextBlock x:Uid="StatsPage_ShareQualityUnit" Text="" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="#A8A092" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="ShareQuote" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="#A8A092" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
