<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ChanJing_App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ChanJing_App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 主题字典：浅色（宣纸白）与深色（墨色）跟随系统切换 -->
            <ResourceDictionary.ThemeDictionaries>
                <!-- 浅色：枯山水 · 宣纸白 -->
                <ResourceDictionary x:Key="Default">
                    <Color x:Key="XuanZhiWhite">#F4F1E8</Color>
                    <Color x:Key="SuJuan">#ECE8DD</Color>
                    <Color x:Key="Mo">#2B2925</Color>
                    <Color x:Key="WuHui">#7A7265</Color>
                    <Color x:Key="TaiQing">#6E7F63</Color>
                    <Color x:Key="JinShan">#A8842C</Color>
                    <Color x:Key="ZheShi">#A0563B</Color>
                    <Color x:Key="CardColor">#FAF8F2</Color>
                    <Color x:Key="BorderColor">#D4CFC4</Color>
                </ResourceDictionary>
                <!-- 深色：墨色 · 宣纸白反转为文字色 -->
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="XuanZhiWhite">#1E1D1A</Color>
                    <Color x:Key="SuJuan">#26241F</Color>
                    <Color x:Key="Mo">#F4F1E8</Color>
                    <Color x:Key="WuHui">#A8A092</Color>
                    <Color x:Key="TaiQing">#9AB08A</Color>
                    <Color x:Key="JinShan">#C9A84C</Color>
                    <Color x:Key="ZheShi">#C97B57</Color>
                    <Color x:Key="CardColor">#2B2925</Color>
                    <Color x:Key="BorderColor">#3A372F</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource XuanZhiWhite}" />
            <SolidColorBrush x:Key="BrushPanel" Color="{StaticResource SuJuan}" />
            <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource Mo}" />
            <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource WuHui}" />
            <SolidColorBrush x:Key="BrushState" Color="{StaticResource TaiQing}" />
            <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource JinShan}" />
            <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ZheShi}" />
            <SolidColorBrush x:Key="BrushCard" Color="{StaticResource CardColor}" />
            <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource BorderColor}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
