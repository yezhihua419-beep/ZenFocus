<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ChanJing_App.FrictionOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="#000000" Opacity="0">
        <Grid.Resources>
            <SolidColorBrush x:Key="OverlayBg" Color="#1A1B1C" Opacity="0.92" />
        </Grid.Resources>
        <Grid Background="{StaticResource OverlayBg}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="24">
                <!-- 倒计时圆环 -->
                <Grid Width="120" Height="120" HorizontalAlignment="Center">
                    <Ellipse Stroke="#7A7265" StrokeThickness="4" Width="120" Height="120" Opacity="0.3" />
                    <TextBlock x:Name="CountdownText" Text="5" FontSize="48" FontWeight="Light"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#F4F3EE" />
                </Grid>

                <!-- 提示文字 -->
                <TextBlock x:Name="HintText" x:Uid="FrictionOverlay_Hint" Text="" FontSize="18"
                           HorizontalAlignment="Center" Foreground="#F4F3EE" Opacity="0.9" />

                <!-- 5秒后显示的按钮 -->
                <StackPanel x:Name="ButtonPanel" Orientation="Horizontal" HorizontalAlignment="Center"
                            Spacing="16" Visibility="Collapsed">
                    <Button x:Uid="FrictionOverlay_Continue" Content="" Click="ContinueFocus_Click"
                            Background="#7A7265" Foreground="White"
                            Padding="28,12" CornerRadius="24" FontSize="14" />
                    <Button x:Name="GiveInButton" x:Uid="FrictionOverlay_GiveIn" Content=""
                            Background="Transparent" BorderBrush="#7A7265"
                            Foreground="#7A7265"
                            Padding="28,12" CornerRadius="24" FontSize="14">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Uid="FrictionOverlay_Allow5" Text="" Click="GiveIn5Min_Click" />
                                <MenuFlyoutItem x:Uid="FrictionOverlay_Allow15" Text="" Click="GiveIn15Min_Click" />
                                <MenuFlyoutItem x:Uid="FrictionOverlay_Allow30" Text="" Click="GiveIn30Min_Click" />
                                <MenuFlyoutItem x:Uid="FrictionOverlay_AllowSession" Text="" Click="GiveInSession_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
